# Appium Configuration
APPIUM_HOST=localhost
APPIUM_PORT=4723

# Platform to run against: mac | windows
TEST_PLATFORM=mac

# macOS App Configuration
MAC_BUNDLE_ID=com.aithinkers.ait-scribe
MAC_APP_PATH=/Applications/Kept.app

# Windows App Configuration
WINDOWS_APP_PATH=C:\Program Files\Kept\Kept.exe

# AI Integration (for test analysis)
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL=gpt-4-turbo-preview

# Jira Integration
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=KEPT

# Kept Dev build under test (goes into bugs and Zephyr), e.g. 2.0.37 (58)
KEPT_BUILD=

# Zephyr Scale (Jira > Zephyr > API Access Tokens). Leave empty to switch Zephyr off.
ZEPHYR_API_TOKEN=
ZEPHYR_PROJECT_KEY=KEPT
ZEPHYR_ENVIRONMENT=
# Record Pass/Fail + test cycles in Zephyr on each run (off until agreed)
ZEPHYR_RECORD=false

# Test Configuration
DEFAULT_TIMEOUT=10000
SCREENSHOT_ON_FAILURE=true
LOG_LEVEL=info

# Bugs from failed tests: review (default, drafts in bug-drafts/, NO Jira ticket) | jira | off
BUG_MODE=review
# Rerun a failing test this many times before it counts
TEST_RETRIES=1

# Self-healing locators (AI fallback is used only when OPENAI_API_KEY is set)
SELF_HEAL=true
